{
  "expo": {
    "name": "Control Diario Asergrup",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.guardscheduler.ti9dj2",
      "infoPlist": {
        "NSCameraUsageDescription": "Fotografiar evidencias de incidencias y vehículos",
        "NSPhotoLibraryUsageDescription": "Adjuntar imágenes de incidencias y vehículos",
        "NSLocationWhenInUseUsageDescription": "Registrar la ubicación al fichar entrada/salida y al reportar incidencias"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0D1117"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.guardscheduler.ti9dj2",
      "permissions": ["android.permission.CAMERA", "android.permission.READ_MEDIA_IMAGES", "android.permission.ACCESS_COARSE_LOCATION", "android.permission.ACCESS_FINE_LOCATION"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Registrar la ubicación al fichar entrada/salida y al reportar incidencias"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Fotografiar evidencias de incidencias y vehículos",
          "photosPermission": "Adjuntar imágenes de incidencias y vehículos"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0D1117"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
